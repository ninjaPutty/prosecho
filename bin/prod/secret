#!/usr/bin/env ruby
# Kamal captures stdout into its secret store; do not invoke this for diagnostics.
load File.expand_path("deploy", __dir__)

begin
  key = ARGV.first
  unless ARGV.length == 1 &&
      %w[KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE PGPASSWORD PGADMINPASSWORD ROCK_API_KEY].include?(key)
    raise ProsechoDeploy::Failure, "Usage: bin/prod/secret SECRET_NAME"
  end
  value = if key == "ROCK_API_KEY"
    ProsechoDeploy.read_rock_key
  else
    ProsechoDeploy.read_secrets(ProsechoDeploy.secrets_file).fetch(key)
  end
  print value
rescue ProsechoDeploy::Failure, SystemCallError
  abort "Deployment secret unavailable; check the external credential file and permissions"
end
