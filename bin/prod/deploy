#!/usr/bin/env ruby
require "open3"
require "fileutils"
require "tmpdir"
require "timeout"
require "json"
require "optparse"

module ProsechoDeploy
  HOST = "prosecho-deploy-cloudflare"
  DOCKER_HOST = "ssh://deploy@#{HOST}"
  SOURCE = File.expand_path("../..", __dir__).freeze
  class Failure < StandardError; end

  # Captures and mutations share the same lock checks, deadline and cancellation.
  class Runner
    attr_accessor :lock

    def check_lock!
      raise Failure, "Target lock connection lost; no new phase allowed. Inspect already-issued remote commands." if lock && IO.select([lock], nil, nil, 0)
    end

    def run(*command, input: nil, capture: false, timeout: 300)
      check_lock!
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
      result = +""
      Open3.popen3(*command, pgroup: true) do |stdin, stdout, stderr, waiter|
        check_lock!
        stdin.write(input) if input
        stdin.close
        readers = [stdout, stderr]
        until readers.empty? && waiter.join(0)
          check_lock!
          raise Failure, "Command timed out: #{command.first}; inspect remote state" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
          ready = IO.select(readers + (lock ? [lock] : []), nil, nil, 0.05)&.first || []
          check_lock!
          (ready & readers).each do |stream|
            chunk = stream.read_nonblock(4096, exception: false)
            if chunk.nil?
              readers.delete(stream)
            elsif chunk != :wait_readable
              if capture
                result << chunk if stream == stdout
                raise Failure, "Command output exceeded limit" if result.bytesize > 1_048_576
              else
                ((stream == stdout) ? $stdout : $stderr).write(chunk)
              end
            end
          end
        end
        check_lock!
        raise Failure, "Command failed: #{command.first} (details suppressed for credential safety)" unless waiter.value.success?
      ensure
        unless waiter.join(0)
          begin
            Process.kill("TERM", -waiter.pid)
            Process.kill("KILL", -waiter.pid) unless waiter.join(2)
          rescue Errno::ESRCH
            # The command exited between the wait and signal.
          end
          waiter.join
        end
      end
      result.strip
    end
  end

  LOCK = <<~SH.freeze
    set -eu
    exec prosecho-cleanup --apply --hold-lock
  SH
  CAPACITY = <<~SH.freeze
    set -eu
    root=$(docker info --format '{{.DockerRootDir}}')
    test "$(df -Pk "$root" | awk 'NR==2 {print $4}')" -ge 4194304
    test "$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)" -ge 2097152
  SH
  CAPACITY_METADATA = <<~SH.freeze
    set -eu
    root=$(docker info --format '{{.DockerRootDir}}')
    disk=$(df -Pk "$root")
    disk=$(printf '%s\n' "$disk" | awk 'NR==2 {print $4}')
    memory=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
    printf '%s %s\n' "$disk" "$memory"
  SH
  POSTGRES_WAIT = <<~SH.freeze
    set -eu
    for i in $(seq 1 60); do
      if docker exec prosecho-postgres pg_isready -h 127.0.0.1 -U postgres -d postgres >/dev/null; then exit 0; fi
      sleep 2
    done
    exit 1
  SH
  BOOTSTRAP = "docker exec -i prosecho-postgres sh -c 'export PGPASSWORD=\"$POSTGRES_PASSWORD\"; exec psql -X -q -w -v ON_ERROR_STOP=1 -h 127.0.0.1 -U postgres -d postgres'"
  DATABASE_WAIT = <<~SH.freeze
    set -eu
    IFS= read -r password
    for i in $(seq 1 60); do
      if printf '%s\n' "$password" | docker exec -i prosecho-postgres sh -c 'IFS= read -r PGPASSWORD; export PGPASSWORD; exec psql -X -w -h 127.0.0.1 -U prosecho -d prosecho_production -Atqc "SELECT 1"' | grep -qx 1; then exit 0; fi
      sleep 2
    done
    exit 1
  SH
  STATUS = <<~SH.freeze
    set -eu
    prosecho-cleanup --help >/dev/null
    docker info >/dev/null
    for marker in cleanup-inflight cleanup-uncertain; do
      test ! -e "$HOME/.local/share/prosecho/$marker"
      test ! -L "$HOME/.local/share/prosecho/$marker"
    done
    for marker in initialized db-prepared; do
      test ! -L "$HOME/.local/share/prosecho/$marker"
      if test -e "$HOME/.local/share/prosecho/$marker"; then
        test -f "$HOME/.local/share/prosecho/$marker"
      fi
    done
    if test -f "$HOME/.local/share/prosecho/initialized"; then
      printf initialized
    else
      printf new
    fi
  SH
  SCHEMA = <<~SH.freeze
    set -eu
    docker exec -i prosecho-postgres sh -c '
      IFS= read -r PGPASSWORD
      export PGPASSWORD PGOPTIONS="-c default_transaction_read_only=on -c statement_timeout=10000"
      exec psql -X -q -w -v ON_ERROR_STOP=1 -h 127.0.0.1 -U prosecho \
        -d prosecho_production -Atc "SELECT version FROM schema_migrations ORDER BY version"
    '
  SH

  def self.clean_sha!(sha, runner = Runner.new)
    raise Failure, "Use a full lowercase 40-character committed SHA" unless sha&.match?(/\A[0-9a-f]{40}\z/)
    raise Failure, "Candidate SHA must be HEAD" unless runner.run("git", "rev-parse", "HEAD", capture: true) == sha
    raise Failure, "Candidate source must be clean" unless runner.run("git", "status", "--porcelain", capture: true).empty?
  end

  def self.with_candidate(source, sha)
    raise Failure, "Use a full lowercase 40-character committed SHA" unless sha&.match?(/\A[0-9a-f]{40}\z/)
    runner = Runner.new
    expected = runner.run("git", "-C", source, "rev-parse", "#{sha}^{commit}", capture: true)
    raise Failure, "Candidate commit mismatch" unless expected == sha
    Dir.mktmpdir("prosecho-release-") do |operation|
      candidate = File.join(operation, "candidate")
      runner.run("git", "clone", "--no-local", "--no-checkout", source, candidate, capture: true)
      runner.run("git", "-C", candidate, "checkout", "--detach", sha, capture: true)
      old_env = ENV.to_h.slice("PATH", "TMPDIR", "BUNDLE_GEMFILE")
      begin
        ENV["PATH"] = ([File.join(candidate, "bin/prod")] + ENV.fetch("PATH").split(":").reject { |path| path.start_with?(source + "/") }).join(":")
        ENV["TMPDIR"] = operation
        ENV["BUNDLE_GEMFILE"] = File.join(candidate, "Gemfile")
        Dir.chdir(candidate) do
          clean_sha!(sha, runner)
          runner.run("git", "ls-files", "-z", capture: true).split("\0").each do |file|
            next if File.symlink?(file)
            File.chmod(File.executable?(file) ? 0o555 : 0o444, file)
          end
          yield runner
          clean_sha!(sha, runner)
        end
      ensure
        %w[PATH TMPDIR BUNDLE_GEMFILE].each { |key| old_env.key?(key) ? ENV[key] = old_env[key] : ENV.delete(key) }
      end
    end
  end

  def self.bootstrap_sql(password, role: "prosecho", database: "prosecho_production")
    raise Failure, "Unsafe database identifier" unless [role, database].all? { |name| name.match?(/\A[a-z][a-z0-9_]{0,62}\z/) }
    raise Failure, "Application password must be 32 to 128 hexadecimal characters" unless password.match?(/\A[0-9a-f]{32,128}\z/)
    <<~SQL
      SET log_statement = 'none';
      SET log_min_duration_statement = -1;
      SET log_min_duration_sample = -1;
      SET log_transaction_sample_rate = 0;
      SET log_min_error_statement = 'panic';
      SELECT 'CREATE ROLE #{role} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT'
      WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '#{role}') \\gexec
      DO $$ BEGIN
        IF EXISTS (SELECT FROM pg_auth_members WHERE member = (SELECT oid FROM pg_roles WHERE rolname = '#{role}')) THEN
          RAISE EXCEPTION 'Application role has unexpected memberships; operator review required';
        END IF;
      END $$;
      ALTER ROLE #{role} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT PASSWORD '#{password}';
      SELECT 'CREATE DATABASE #{database} OWNER #{role}'
      WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '#{database}') \\gexec
      ALTER DATABASE #{database} OWNER TO #{role};
    SQL
  end

  def self.read_rock_key(file = rock_key_file)
    stat = File.lstat(file)
    unless stat.file? && stat.mode & 0o777 == 0o600 && stat.size <= 4098
      raise Failure, "Rock key file must be a bounded regular file with mode 600"
    end
    key = File.binread(file).strip
    unless key.bytesize.between?(1, 4096) && key.ascii_only? &&
        key.bytes.all? { |byte| byte.between?(33, 126) }
      raise Failure, "Rock key must contain one nonempty printable token"
    end
    key
  rescue SystemCallError
    raise Failure, "Cannot read Rock key file; provision an approved regular mode-600 file"
  end

  def self.read_secrets(file)
    stat = File.lstat(file)
    unless stat.file? && stat.mode & 0o777 == 0o600 && stat.size <= 4096
      raise Failure, "app.env must be a bounded regular file with mode 600"
    end
    lines = File.readlines(file, chomp: true)
    keys = %w[KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE PGPASSWORD PGADMINPASSWORD]
    raise Failure, "app.env requires exactly four unique unquoted KEY=value lines" unless lines.size == 4 && lines.map { |line| line.split("=", 2).first }.sort == keys.sort && lines.all? { |line| line.match?(/\A[A-Z_]+=[A-Za-z0-9._-]+\z/) }
    secrets = lines.to_h { |line| line.split("=", 2) }
    %w[PGPASSWORD PGADMINPASSWORD SECRET_KEY_BASE].each do |key|
      raise Failure, "#{key} must be 32 to 128 hexadecimal characters" unless secrets.fetch(key).match?(/\A[0-9a-f]{32,128}\z/)
    end
    raise Failure, "Database admin and app passwords must differ" if secrets["PGPASSWORD"] == secrets["PGADMINPASSWORD"]
    secrets
  rescue SystemCallError
    raise Failure, "Cannot read app.env; provision the approved four-key mode-600 file"
  end

  def self.verify_identity!(runner)
    identities = runner.run("ssh-add", "-L", capture: true, timeout: 30).lines.map { |line| line.split.first(2) }
    pinned = File.read(".devcontainer/production_deploy.pub").split.first(2)
    raise Failure, "Forwarded SSH agent must contain the pinned Prosecho deployment key" unless identities.include?(pinned)
  end

  def self.rock_key_file
    ENV.fetch("PROSECHO_ROCK_API_KEY_FILE") do
      File.file?("/run/prosecho/rock-api-key") ? "/run/prosecho/rock-api-key" :
        File.join(Dir.home, ".local/share/prosecho/rock-api-key")
    end
  end

  def self.secrets_file
    ENV.fetch("PROSECHO_DEPLOY_SECRETS_FILE") do
      File.file?("/run/prosecho/app.env") ? "/run/prosecho/app.env" : File.join(Dir.home, ".local/share/prosecho/app.env")
    end
  end

  def self.phase_input(kind, secrets)
    case kind
    when "bootstrap" then bootstrap_sql(secrets.fetch("PGPASSWORD"))
    when "app-query" then secrets.fetch("PGPASSWORD") + "\n"
    when "database" then %w[SECRET_KEY_BASE PGPASSWORD].map { |key| "#{key}=#{secrets.fetch(key)}\n" }.join
    end
  end

  def self.artifact_script(sha, record: false)
    <<~SH
      set -eu
      file="$HOME/.local/share/prosecho/images/#{sha}"
      url="http://127.0.0.1:5555/v2/prosecho/manifests/#{sha}"
      accept='Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json, application/vnd.docker.distribution.manifest.list.v2+json'
      code=$(curl --max-time 10 -sS -o /dev/null -w '%{http_code}' -H "$accept" "$url")
      if test "$code" = 404; then test ! -f "$file"; printf new; exit 0; fi
      test "$code" = 200
      digest=$(curl --max-time 10 -fsSI -H "$accept" "$url" | awk 'tolower($1)=="docker-content-digest:" {gsub("\\r", "", $2); print $2}')
      printf '%s' "$digest" | grep -Eq '^sha256:[0-9a-f]{64}$'
      #{record ? 'mkdir -p "$(dirname "$file")"; (set -C; printf "%s\n" "$digest" >"$file")' : 'test -f "$file"; test "$(cat "$file")" = "$digest"'}
      printf '%s' "$digest"
    SH
  end

  def self.phases(mode, sha, migrate: false)
    kamal = ["bundle", "exec", "kamal"]
    commands = []
    if mode == "rollback"
      commands << ["ssh", HOST, "docker inspect prosecho-web-#{sha} >/dev/null"]
      commands << [*kamal, "rollback", sha]
    else
      commands << [*kamal, "build", "push", "--version", sha]
      if mode == "install"
        commands << ["ssh", HOST, "docker network inspect kamal >/dev/null 2>&1 || docker network create kamal"]
        commands << [*kamal, "accessory", "boot", "postgres", "--version", sha]
        commands << ["ssh", HOST, POSTGRES_WAIT]
        commands << ["bootstrap", "ssh", HOST, BOOTSTRAP]
      end
      commands << ["app-query", "ssh", HOST, DATABASE_WAIT]
      commands << [*kamal, "build", "pull", "--version", sha]
      task = (mode == "install") ? "db:prepare" : "db:migrate"
      database = "docker run --rm -i --network kamal --env-file /dev/stdin -e PGHOST=prosecho-postgres -e PGUSER=prosecho -e PGDATABASE=prosecho_production 127.0.0.1:5555/prosecho:#{sha} bin/rails #{task}"
      database = "test -f ~/.local/share/prosecho/db-prepared || { #{database} && touch ~/.local/share/prosecho/db-prepared; }" if mode == "install"
      commands << ["database", "ssh", HOST, database] if mode == "install" || migrate
      commands << [*kamal, "proxy", "boot", "--version", sha] if mode == "install"
      commands << [*kamal, "redeploy", "--skip-push", "--version", sha]
    end
    commands << ["ssh", HOST, "curl --max-time 10 --fail --silent --show-error -H 'Host: prosecho.menloparking.com' http://127.0.0.1:8080/ready"]
    commands << ["ssh", HOST, "touch ~/.local/share/prosecho/initialized"] if mode == "install"
    commands
  end

  def self.deploy(mode, sha, runner, secrets, allow_migrations: false)
    lock = IO.popen(["ssh", HOST, LOCK], "r+", pgroup: true)
    begin
      begin
        raise Failure, "Target lock/capacity check failed" unless Timeout.timeout(210) { lock.gets } == "LOCKED\n"
      rescue Timeout::Error
        raise Failure, "Target lock/capacity check timed out"
      end
      runner.lock = lock
      state = readiness(mode, sha, runner, secrets)
      approve_migrations!(sha, state, allow_migrations) if mode == "deploy"
      artifact = state.fetch(:artifact)
      phases(mode, sha, migrate: state.fetch(:pending).any?).each do |command|
        clean_sha!(sha, runner)
        push = command[0, 5] == %w[bundle exec kamal build push]
        next if push && artifact != "new"
        if artifact != "new"
          raise Failure, "Immutable SHA artifact changed" unless runner.run("ssh", HOST, artifact_script(sha), capture: true, timeout: 30) == artifact
        end
        kind = %w[bootstrap app-query database].include?(command.first) ? command.shift : nil
        activation = command.include?("redeploy") || command.include?("rollback")
        runner.run("ssh", HOST, CAPACITY, timeout: 30) if kind == "database" || activation
        runner.run(*command, input: phase_input(kind, secrets), capture: !kind.nil?, timeout: push ? 1800 : 300)
        artifact = runner.run("ssh", HOST, artifact_script(sha, record: true), capture: true, timeout: 30) if push
        raise Failure, "Build did not publish the SHA artifact" if artifact == "new"
      end
      runner.check_lock!
      lock.puts JSON.generate(sha: sha, digest: artifact)
      lock.flush
      begin
        raise Failure, "Successful-release verification/recording failed" unless Timeout.timeout(60) { lock.gets } == "RECORDED\n"
      rescue Timeout::Error
        raise Failure, "Successful-release verification/recording timed out; inspect guest state"
      end
      begin
        warn "Post-release cleanup did not finish; inspect guest cleanup logs" unless Timeout.timeout(600) { lock.gets } == "CLEANED\n"
      rescue Timeout::Error
        warn "Post-release cleanup timed out; release is recorded, inspect guest state"
      end
    ensure
      runner.lock = nil
      unless lock.closed?
        # Only the lock transport is terminated; remote phase cancellation is not guaranteed.
        pid = lock.pid
        begin
          Process.kill("TERM", -pid)
          Timeout.timeout(2) { lock.close }
        rescue Timeout::Error
          Process.kill("KILL", -pid)
          lock.close unless lock.closed?
        rescue Errno::ESRCH
          lock.close
        end
      end
    end
  end

  def self.approve_migrations!(sha, state, allowed)
    return if state.fetch(:pending).empty? || allowed || !state.fetch(:initialized)
    raise Failure, "#{state.fetch(:pending).size} pending migrations for #{sha}; review backups/compatibility, then rerun bin/prod/deploy #{sha} --allow-migrations"
  end

  def self.options(args)
    args = args.dup
    mode = %w[check plan install rollback].include?(args.first) ? args.shift : "deploy"
    options = {mode: mode, allow_migrations: false, allow_rollback: false}
    parser = OptionParser.new do |cli|
      cli.banner = "Usage: bin/prod/deploy [REF]\n       bin/prod/deploy check|plan|install [REF]\n       bin/prod/deploy rollback REF --allow-rollback"
      cli.separator "REF defaults to committed HEAD; accepts a branch, tag or SHA."
      cli.separator "check: full tests + read-only readiness; plan: readiness without tests/build."
      cli.separator "install: explicit one-time bootstrap; rollback: retained image, no down migrations."
      cli.on("--allow-migrations", "Deploy only: approve pending migrations after backup/schema review") { options[:allow_migrations] = true }
      cli.on("--allow-rollback", "Rollback only: approve retained revision's schema compatibility") { options[:allow_rollback] = true }
      cli.on("-h", "--help", "Show help without container or network access") { options[:help] = true }
    end
    parser.parse!(args)
    return options.merge(help: parser.to_s) if options[:help]
    raise Failure, "Expected at most one Git ref; first/migrate verbs were replaced by install/default deployment" if args.size > 1 || %w[first migrate].include?(args.first)
    raise Failure, "--allow-migrations is only valid for normal deployment" if options[:allow_migrations] && mode != "deploy"
    raise Failure, "--allow-rollback is only valid for rollback" if options[:allow_rollback] && mode != "rollback"
    if mode == "rollback" && (args.empty? || !options[:allow_rollback])
      raise Failure, "Rollback requires REF and --allow-rollback after schema compatibility review"
    end
    options.merge(ref: args.first || "HEAD")
  rescue OptionParser::ParseError
    raise Failure, "Invalid option; run bin/prod/deploy --help"
  end

  def self.preflight_probe(runner, message, script, input: nil)
    runner.run("ssh", HOST, script, input: input, capture: true, timeout: 30)
  rescue Failure, SystemCallError => error
    detail = if error.message.start_with?("Target lock connection lost")
      "; target lock connection lost; no new phase allowed; inspect remote state"
    elsif error.message.start_with?("Command timed out")
      "; timed out; inspect remote state"
    else
      ""
    end
    raise Failure, message + detail
  end

  def self.readiness(mode, sha, runner, secrets, allow_disk_recovery: false)
    status = preflight_probe(runner,
      "Production status check failed; verify SSH/Docker, cleanup --help and state markers", STATUS)
    raise Failure, "Invalid production initialization status" unless %w[new initialized].include?(status)
    initialized = status == "initialized"
    raise Failure, "Install refused: initialized marker exists" if mode == "install" && initialized
    if %w[deploy rollback].include?(mode) && !initialized
      raise Failure, "Production is uninitialized; use explicit bin/prod/deploy install #{sha}"
    end
    capacity = preflight_probe(runner,
      "Production capacity metadata check failed; verify Docker storage and /proc/meminfo",
      CAPACITY_METADATA)
    unless capacity.match?(/\A[0-9]+ [0-9]+\z/)
      raise Failure, "Production capacity metadata invalid; expected disk and memory KiB"
    end
    disk, memory = capacity.split.map(&:to_i)
    raise Failure, "Production memory below 2 GiB; provision capacity before deployment" if memory < 2097152
    low_disk = disk < 4194304
    if low_disk && !allow_disk_recovery && !%w[check plan].include?(mode)
      raise Failure, "Production disk below 4 GiB after locked recovery; provision storage"
    end
    applied = []
    if initialized
      versions = preflight_probe(runner,
        "App database authentication/schema metadata check failed; verify app.env, connectivity and schema",
        SCHEMA, input: phase_input("app-query", secrets))
      applied = versions.lines.map(&:strip)
      unless applied.all? { |version| version.match?(/\A[0-9]{1,14}\z/) } && applied.uniq == applied
        raise Failure, "Invalid applied migration metadata"
      end
    end
    files = Dir.glob("db/migrate/[0-9]*_*.rb").sort
    versions = files.map { |file| File.basename(file).split("_", 2).first }
    unless versions.all? { |version| version.match?(/\A[0-9]{1,14}\z/) } && versions.uniq == versions
      raise Failure, "Invalid candidate migration versions"
    end
    missing = applied - versions
    if missing.any? && mode != "rollback"
      raise Failure, "Schema mismatch: #{missing.size} applied migrations absent from #{sha}; review explicit rollback instead"
    end
    artifact = preflight_probe(runner,
      "Artifact metadata check failed; verify loopback registry and immutable digest records",
      artifact_script(sha))
    if mode == "rollback"
      raise Failure, "Rollback artifact is missing" if artifact == "new"
      preflight_probe(runner,
        "Retained rollback container check failed; verify the canonical retained container",
        "docker inspect prosecho-web-#{sha} >/dev/null")
    end
    pending = files.reject { |file| applied.include?(File.basename(file).split("_", 2).first) }
    if mode == "rollback" && pending.any?
      raise Failure, "Rollback candidate has unapplied migrations; rollback never migrates the database"
    end
    {initialized: initialized, artifact: artifact, pending: pending, low_disk: low_disk}
  end

  def self.main(args)
    options = options(args)
    if options[:help]
      puts options[:help]
      return
    end
    mode = options.fetch(:mode)
    container = File.exist?("/.dockerenv") || File.exist?("/run/.containerenv")
    raise Failure, "Run inside the Prosecho devcontainer" unless container
    source_runner = Runner.new
    sha = source_runner.run("git", "-C", SOURCE, "rev-parse", "--verify",
      "--end-of-options", "#{options.fetch(:ref)}^{commit}", capture: true).freeze
    raise Failure, "Git ref must resolve to a full committed SHA" unless sha.match?(/\A[0-9a-f]{40}\z/)
    puts "Candidate #{options.fetch(:ref).inspect} -> #{sha}"
    unless source_runner.run("git", "-C", SOURCE, "status", "--porcelain", capture: true).empty?
      warn "Dirty worktree: uncommitted changes are excluded; using committed #{sha}"
    end
    trap("TERM") { raise Interrupt }
    with_candidate(SOURCE, sha) do |runner|
      ENV["DOCKER_HOST"] ||= DOCKER_HOST
      raise Failure, "Remote Docker host required" unless ENV["DOCKER_HOST"] == DOCKER_HOST
      [[%w[bundle exec kamal version], "2.12.0"], [%w[docker --version], "28.5.2,"], [%w[docker buildx version], "v0.29.1 "], [%w[cloudflared --version], "2026.5.2 "]].each do |command, version|
        raise Failure, "Deployment tool version mismatch" unless runner.run(*command, capture: true, timeout: 30).include?(version)
      end
      verify_identity!(runner)
      secrets = read_secrets(secrets_file)
      read_rock_key
      state = readiness(mode, sha, runner, secrets,
        allow_disk_recovery: %w[deploy install].include?(mode))
      puts "Production: #{state[:initialized] ? "initialized; app-role schema authenticated" : "uninitialized; explicit install required (no app-role schema proof)"}"
      puts "Artifact: #{(state[:artifact] == "new") ? "build required" : "reuse recorded digest #{state[:artifact]}"}"
      puts "Pending migrations: #{state[:pending].size}"
      state[:pending].each { |file| puts "  #{file}" }
      if state[:low_disk]
        puts "Capacity: NOT READY; disk below 4 GiB. Locked cache recovery needed; success not guaranteed."
        puts "Read-only preflight performed no cleanup."
        raise Failure, "Production readiness not ready: disk below 4 GiB" if mode == "check"
      end
      if mode == "plan"
        puts "Tests not run; no build, lock, cleanup or target mutation."
        puts "Actions: #{state[:initialized] ? "build/reuse, pull, optional migrate, redeploy, health verification" : "explicit install: bootstrap, prepare, proxy, redeploy, health verification"}"
        puts "Approval required: --allow-migrations after backup/schema review" if state[:initialized] && state[:pending].any?
        next
      end
      approve_migrations!(sha, state, options[:allow_migrations]) if mode == "deploy"
      runner.run("bin/check", timeout: 600)
      clean_sha!(sha, runner)
      puts "Checked isolated candidate #{sha}"
      next if mode == "check"
      deploy(mode, sha, runner, secrets, allow_migrations: options[:allow_migrations])
    end
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    ProsechoDeploy.main(ARGV)
  rescue ProsechoDeploy::Failure => error
    abort error.message
  end
end
