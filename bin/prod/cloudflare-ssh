#!/bin/sh
set -eu
CF_SSH_HOST=${CF_SSH_HOST:-ssh-prosecho.menloparking.com}
unset TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET
if ! command -v cloudflared >/dev/null 2>&1; then
  printf '%s\n' 'cloudflared is missing; rebuild the Prosecho devcontainer image.' >&2
  exit 1
fi
exec cloudflared access ssh --hostname "$CF_SSH_HOST"
