Host prosecho-deploy-cloudflare
  HostName prosecho-deploy-cloudflare
  User deploy
  IdentityAgent /run/prosecho/agent.sock
  IdentityFile /run/prosecho/deploy.pub
  IdentitiesOnly yes
  ForwardAgent no
  BatchMode yes
  PreferredAuthentications publickey
  StrictHostKeyChecking yes
  UserKnownHostsFile /run/prosecho/known_hosts
  GlobalKnownHostsFile /dev/null
  ProxyCommand /usr/bin/env cloudflare-ssh
  ServerAliveInterval 15
  ServerAliveCountMax 3
