FROM docker.io/library/docker:28.5.2-cli@sha256:cd58b396e427d1ee8cddcc3f3b7e8d8c2ba45755c5dd5b821b6e615e1ccf4586 AS docker
FROM docker.io/library/node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS node
FROM ghcr.io/rails/devcontainer/images/ruby:3.4.7
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY verify-ai-clis.sh /usr/local/bin/verify-ai-clis
COPY install-cloudflared.sh /usr/local/bin/install-cloudflared
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
RUN usermod -g 100 vscode && apt-get update && \
    apt-get install -y --no-install-recommends curl jq openssh-client postgresql-client python3 && \
    rm -rf /var/lib/apt/lists/* && \
    sh /usr/local/bin/install-cloudflared && \
    mkdir -p /home/vscode/.ssh && chown vscode:100 /home/vscode/.ssh && chmod 700 /home/vscode/.ssh
COPY --chown=vscode:100 ssh.deploy /home/vscode/.ssh/config
RUN chmod 600 /home/vscode/.ssh/config && docker --version && docker buildx version && cloudflared --version
# Keep these pins aligned with Dockerfile; npm selects the platform optional binaries.
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    npm install --global --prefix /usr/local --include=optional --engine-strict \
      opencode-ai@1.18.33 @openai/codex@0.159.1 @anthropic-ai/claude-code@2.1.285 && \
    npm cache clean --force && chmod 755 /usr/local/bin/verify-ai-clis
ENV DISABLE_AUTOUPDATER=1
USER vscode
ENV PATH="/prosecho/bin/prod:/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:${PATH}"
RUN verify-ai-clis
WORKDIR /prosecho
